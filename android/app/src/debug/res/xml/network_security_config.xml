<?xml version="1.0" encoding="utf-8"?>
<!-- Build debug uniquement : HTTP en clair autorisé vers le PC de dev vu depuis l'émulateur (10.0.2.2)
     et vers la VM Freebox sur le réseau local.
     Le build release garde src/main/res/xml/network_security_config.xml (HTTPS obligatoire). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.41</domain> <!-- VM Freebox -->

    </domain-config>
</network-security-config>
