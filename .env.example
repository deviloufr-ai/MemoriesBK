# Copier en .env puis remplir. Ne jamais committer .env.
POSTGRES_PASSWORD=change-me
JWT_SECRET=                       # openssl rand -hex 32

# Stockage
PHOTOS_HOST_DIR=/mnt/nas/photos-app   # dossier dédié à l'app sur le NAS monté (NFS/SMB), jamais ta collection existante
THUMBS_HOST_DIR=./data/thumbs     # SSD local de préférence
IMPORT_HOST_DIR=/mnt/nas          # dossiers importables depuis la page web, montés en lecture seule
IMPORT_EXCLUDE=photos-app,trashbox   # sous-dossiers jamais parcourus (dont la bibliothèque elle-même)
PG_HOST_DIR=./data/postgres       # SSD local, jamais sur le NAS
TZ=Europe/Paris                   # fuseau des dates vidéo (QuickTime UTC -> local)

# Analyse VLM : off | gemini | ollama
# Tier gratuit Gemini : Google peut utiliser les images envoyées pour améliorer ses produits.
VLM_PROVIDER=off
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_MODEL=qwen2.5vl:7b
VLM_RATE_LIMIT=8/m                # sous la limite RPM du tier gratuit
VLM_HOURLY_BUDGET=20              # ≈ quota quotidien gratuit / 24

# Réglages fins
FACE_MAX_DIST=0.6
MAX_UPLOAD_BYTES=53687091200
TOKEN_TTL_DAYS=90
