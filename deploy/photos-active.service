[Unit]
Description=MemoriesBK actif sur ce serveur (reprise depuis la Freebox, rendu à l'arrêt)
Wants=network-online.target
After=network-online.target docker.service remote-fs.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/photos-switch takeover
ExecStop=/usr/local/bin/photos-switch handback
TimeoutStartSec=1h
TimeoutStopSec=15min

[Install]
WantedBy=multi-user.target
